# ==========================================
# AgriShield AI Backend - Environment Variables
# Copy this file to .env and fill in your values.
# Never commit the real .env file.
# ==========================================

# Server port
PORT=5000

# Node environment: development | production | test
NODE_ENV=development

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host:5432/postgres

# JWT signing secret (must be at least 10 characters long)
JWT_SECRET=change_me_to_a_long_random_secret

# JWT token expiry (e.g. 7d, 1h)
JWT_EXPIRES_IN=7d

# bcrypt hashing rounds (integer)
BCRYPT_ROUNDS=10

# Repository provider: postgres (default) | mock
# 'mock' uses in-memory repositories and does not require a database.
DATABASE_PROVIDER=postgres

# FastAPI Inference Server
FASTAPI_URL=http://localhost:8000
